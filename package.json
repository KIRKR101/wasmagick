{
	"name": "wasmagick",
	"private": true,
	"version": "0.0.1",
	"description": "Client-side image editor powered by WebAssembly ImageMagick.",
	"author": "WASMagick contributors",
	"type": "module",
	"main": "electron/main.cjs",
	"scripts": {
		"copy:wasm": "npx tsx tooling/copy-wasm.ts",
		"predev": "npm run copy:wasm",
		"dev": "vite dev",
		"prebuild": "npm run copy:wasm",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"setup:imagemagick": "npx tsx tooling/setup-imagemagick.ts",
		"golden-gen": "npm run setup:imagemagick && npx tsx test/golden-gen/generate.ts",
		"test:unit": "vitest",
		"test:unit:run": "vitest run --exclude 'test/parity/**'",
		"test:parity": "npm run setup:imagemagick && vitest run test/parity/",
		"test": "npm run setup:imagemagick && vitest run",
		"dev:electron": "concurrently -k \"npm run dev -- --port 5173 --strictPort\" \"wait-on http://localhost:5173 && electron . --dev\"",
		"build:electron": "cross-env ELECTRON=1 npm run build && electron-builder",
		"build:electron:dir": "cross-env ELECTRON=1 npm run build && electron-builder --dir"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.2.8",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.21.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24",
		"@types/pixelmatch": "^5.2.6",
		"@types/pngjs": "^6.0.5",
		"@vite-pwa/sveltekit": "^1.1.0",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.5",
		"cross-env": "^10.1.0",
		"electron": "^43.4.1",
		"electron-builder": "^26.15.3",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"paneforge": "^1.0.2",
		"pixelmatch": "^7.2.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.23.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^7.3.1",
		"vitest": "^4.1.0",
		"wait-on": "^9.1.0",
		"wrangler": "^4.114.0"
	},
	"dependencies": {
		"@fontsource-variable/geist-mono": "^5.2.7",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@imagemagick/magick-wasm": "^0.0.42",
		"@uswriting/exiftool": "^1.0.9",
		"lucide-svelte": "^1.0.1",
		"svelte-icons": "^2.1.0"
	},
	"build": {
		"appId": "com.wasmagick.app",
		"productName": "WASMagick",
		"directories": {
			"output": "release"
		},
		"files": [
			"build/**",
			"electron/**"
		],
		"win": {
			"target": "nsis",
			"icon": "static/icons/icon-512.png",
			"fileAssociations": [
				{
					"ext": [
						"png",
						"jpg",
						"jpeg",
						"gif",
						"webp",
						"bmp",
						"tiff",
						"avif",
						"svg",
						"ico",
						"heic",
						"heif"
					],
					"name": "Image",
					"description": "Image file"
				}
			]
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		},
		"mac": {
			"target": "dmg",
			"icon": "static/icons/icon-512.png",
			"category": "public.app-category.photography"
		},
		"linux": {
			"target": "AppImage",
			"icon": "static/icons/icon-512.png",
			"category": "Graphics"
		}
	}
}
